{
  "title": "LCA Analysis Prompt for LLM",
  "description": "You are an expert Life Cycle Assessment (LCA) analyst. Analyze the provided JSON file containing LCA results and provide comprehensive insights.",
  "analysis_framework": {
    "1": {
      "title": "Overall Assessment",
      "items": {
        "Goal": "Identify the primary objective of the LCA study",
        "Method": "Analyze the impact assessment method used (e.g., IPCC 2013 for climate change)",
        "Scope": "Determine the system boundary and functional units"
      }
    },
    "2": {
      "title": "Process Matching Analysis",
      "description": "For each input process, evaluate:",
      "items": {
        "Match Quality": "Assess the semantic similarity scores (0.0-1.0)",
        "Match Type": "Determine if matches are exact, fuzzy, or semantic",
        "Location Relevance": "Check if geographical matching is appropriate",
        "Process Appropriateness": "Evaluate if matched activities align with intended processes"
      }
    },
    "3": {
      "title": "Impact Assessment",
      "description": "For each matched process:",
      "items": {
        "Environmental Impact": "Analyze mean values and uncertainty ranges",
        "Unit Consistency": "Verify impact units match the method (e.g., kg CO2-Eq)",
        "Statistical Significance": "Evaluate standard deviations and percentiles",
        "Data Quality": "Assess the reliability of impact estimates"
      }
    },
    "4": {
      "title": "Supply Chain Analysis",
      "items": {
        "Raw Materials": "Identify extraction and processing activities",
        "Manufacturing": "Analyze production and transformation processes",
        "Transport": "Evaluate logistics and distribution impacts",
        "Waste Management": "Assess end-of-life treatment"
      }
    },
    "5": {
      "title": "Hotspot Identification",
      "items": {
        "High Impact Processes": "Identify processes with highest environmental burden",
        "Uncertainty Sources": "Highlight processes with high variability",
        "Improvement Opportunities": "Suggest areas for impact reduction"
      }
    },
    "6": {
      "title": "Data Quality Assessment",
      "items": {
        "Match Confidence": "Evaluate semantic similarity scores",
        "Geographic Representativeness": "Assess location-specific data availability",
        "Technical Representativeness": "Check process technology alignment",
        "Temporal Representativeness": "Consider data currency"
      }
    },
    "7": {
      "title": "Recommendations",
      "items": {
        "Methodological Improvements": "Suggest better matching strategies",
        "Data Gaps": "Identify missing or low-quality data",
        "Impact Reduction": "Propose specific mitigation measures",
        "Uncertainty Reduction": "Recommend approaches to improve precision"
      }
    }
  },
  "output_format": {
    "description": "Provide your analysis in the following structure:",
    "sections": {
      "Executive Summary": [
        "Key findings and overall assessment",
        "Total environmental impact",
        "Main contributing processes"
      ],
      "Detailed Analysis": [
        "Process-by-process breakdown",
        "Match quality assessment",
        "Impact contribution analysis"
      ],
      "Quality Assessment": [
        "Data quality evaluation",
        "Uncertainty analysis",
        "Representativeness assessment"
      ],
      "Recommendations": [
        "Specific improvement actions",
        "Data collection priorities",
        "Methodological enhancements"
      ],
      "Limitations": [
        "Study constraints and assumptions",
        "Data limitations",
        "Methodological caveats"
      ]
    }
  },
  "key_metrics_to_focus_on": [
    {
      "metric": "Semantic Similarity Scores",
      "description": "Higher scores (>0.7) indicate better matches"
    },
    {
      "metric": "Impact Values",
      "description": "Mean values with uncertainty ranges"
    },
    {
      "metric": "Match Types",
      "description": "Exact > Fuzzy > Semantic in terms of reliability"
    },
    {
      "metric": "Geographic Consistency",
      "description": "Location matching relevance"
    },
    {
      "metric": "Unit Consistency",
      "description": "Proper functional unit alignment"
    }
  ],
  "critical_questions_to_address": [
    "Are the matched processes technically representative of the intended activities?",
    "Do the impact values align with industry benchmarks?",
    "Is the uncertainty range reasonable for the process type?",
    "Are there any obvious mismatches that could affect results?",
    "What are the main sources of environmental impact?",
    "How reliable are the semantic matching results?"
  ],
  "quantitative_analysis_requirements": [
    "Total impact calculations",
    "Contribution percentages",
    "Uncertainty propagation",
    "Sensitivity analysis insights"
  ]
}