      "Data availability: Some regions may have limited data"
    ],
    "unit_consistency": {
      "input_units": "User-specified functional units",
      "database_units": "Units in the LCA database",
      "impact_units": "Method-specific units (e.g., kg CO2-Eq)"
    }
  },
  "quality_indicators": {
    "high_quality_indicators": [
      "Semantic similarity scores > 0.7",
      "Low standard deviations",
