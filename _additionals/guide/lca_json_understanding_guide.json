{
  "title": "Understanding LCA JSON Output Structure",
  "overview": "This document explains the structure and interpretation of JSON files generated by the EcoinventEngine for Life Cycle Assessment (LCA) analysis. The JSON contains comprehensive information about process matching, environmental impacts, and uncertainty analysis.",
  "json_structure": {
    "top_level_structure": {
      "example": {
        "goal": "Compare environmental impact with uncertainty",
        "method": ["IPCC 2013", "climate change", "GWP 100a"],
        "results": []
      }
    },
    "key_components": [
      {
        "name": "Goal",
        "purpose": "Defines the primary objective of the LCA study",
        "example": "Compare environmental impact with uncertainty",
        "interpretation": "Indicates the study focuses on environmental impact comparison with uncertainty quantification"
      },
      {
        "name": "Method",
        "format": "Array containing impact assessment method information",
        "example": ["IPCC 2013", "climate change", "GWP 100a"],
        "components": [
          "Method name (e.g., \"IPCC 2013\")",
          "Impact category (e.g., \"climate change\")",
          "Characterization factor (e.g., \"GWP 100a\")"
        ],
        "interpretation": "Specifies the environmental impact assessment method used"
      },
      {
        "name": "Results Array",
        "description": "Contains detailed analysis for each input process, with each result object containing:"
      }
    ],
    "individual_result_structure": {
      "input_information": {
        "example": {
          "input": {
            "name": "iron ore mining",
            "amount": 1.0,
            "unit": "ton",
            "location": "CN",
            "system_boundary": "cradle-to-gate",
            "stage": "raw material extraction"
          }
        },
        "fields_explained": {
          "name": "Process name as specified by user",
          "amount": "Quantity of the functional unit",
          "unit": "Unit of measurement",
          "location": "Geographic location code (e.g., \"CN\" for China)",
          "system_boundary": "LCA system boundary (e.g., \"cradle-to-gate\")",
          "stage": "Life cycle stage classification"
        }
      },
      "match_information": {
        "example": {
          "match_type": "semantic",
          "matched_activity": {
            "name": "vanadium-titanomagnetite mine operation and beneficiation",
            "unit": "kilogram",
            "location": "CN",
            "database": "ecoinvent 3.8 cutoff",
            "code": "bc201cb1098f4031dc2972a5f735af95",
            "reference_product": "iron ore concentrate"
          }
        },
        "match_types": [
          {
            "type": "exact",
            "description": "Perfect name and location match"
          },
          {
            "type": "fuzzy",
            "description": "Similar name match using string similarity"
          },
          {
            "type": "semantic",
            "description": "Semantic similarity using AI embedding"
          }
        ],
        "matched_activity_fields": {
          "name": "Actual process name in database",
          "unit": "Database unit (may differ from input)",
          "location": "Geographic location in database",
          "database": "Source database name",
          "code": "Unique identifier in database",
          "reference_product": "Main output product"
        }
      },
      "impact_assessment": {
        "example": {
          "impact": {
            "mean": 0.34129602282053645,
            "std_dev": 1.1102230246251565e-16,
            "percentile_5": 0.34129602282053656,
            "percentile_95": 0.34129602282053656,
            "unit": "kg CO2-Eq"
          }
        },
        "statistical_measures": {
          "mean": "Average environmental impact",
          "std_dev": "Standard deviation (uncertainty measure)",
          "percentile_5": "5th percentile value",
          "percentile_95": "95th percentile value",
          "unit": "Impact unit (e.g., \"kg CO2-Eq\" for climate change)"
        }
      },
      "match_history": {
        "example": {
          "match_history": {
            "input_name": "iron ore mining",
            "location": "CN",
            "stage": "raw material extraction",
            "matched_activity": {},
            "match_type": "semantic",
            "suggestions": [],
            "score": 0.6505851745605469
          }
        },
        "match_history_components": [
          "input_name: Original process name",
          "location: Geographic location",
          "stage: Life cycle stage",
          "matched_activity: Best matched process",
          "match_type: Type of matching used",
          "suggestions: Alternative matches with scores",
          "score: Semantic similarity score (0.0-1.0)"
        ]
      }
    },
    "suggestions_array_structure": {
      "example": {
        "suggestions": [
          {
            "activity": {
              "name": "vanadium-titanomagnetite mine operation and beneficiation",
              "unit": "kilogram",
              "location": "CN",
              "database": "ecoinvent 3.8 cutoff",
              "code": "bc201cb1098f4031dc2972a5f735af95",
              "reference_product": "iron ore concentrate"
            },
            "score": 0.6505851745605469
          }
        ]
      },
      "suggestion_fields": {
        "activity": "Alternative process information",
        "score": "Semantic similarity score (higher = better match)"
      }
    }
  },
  "data_interpretation_guidelines": {
    "match_quality_assessment": {
      "score_gt_0_7": "High confidence match",
